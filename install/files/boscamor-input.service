[Unit]
Description=Launcher input daemon (global keys, app lifecycle, power)

[Service]
ExecStart=/usr/bin/python3 /opt/boscamor/boscamor-input.py
Restart=on-failure
RestartSec=2

# No [Install]: Cinnamon never starts graphical-session.target, so the
# session autostart entry boscamor-input.desktop starts this unit (D67).
