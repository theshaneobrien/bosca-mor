# On the desktop the launcher is only minimised, so this raises it (Home
# comes back) and starts a new one only when none is running.
[Desktop Entry]
Type=Application
Name=Launcher
Comment=Open the TV launcher
Exec=sh -c "wmctrl -F -a Launcher || exec /opt/boscamor/boscamor"
Icon=boscamor-launcher
StartupWMClass=Launcher
Terminal=false
Categories=AudioVideo;
